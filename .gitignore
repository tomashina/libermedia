# Local operating-system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
/.env
/.env.*
!/.env.example

# Environment-specific OpenCart configuration (contains credentials and paths)
/upload/config.php
/upload/admin/config.php
/upload/LocalValetDriver.php

# Database exports and archives
/*.sql
/*.sql.gz
/*.zip
/*.tar
/*.tar.gz

# Product and content media are synchronized separately from the live store
/upload/image/

# Generated sitemaps and hosting metadata
/upload/sitemaps/
/upload/.ftpquota

# OpenCart runtime data outside the public web root
/storageunbtbl/cache/*
!/storageunbtbl/cache/index.html
/storageunbtbl/download/*
!/storageunbtbl/download/index.html
/storageunbtbl/logs/*
!/storageunbtbl/logs/index.html
/storageunbtbl/modification/*
!/storageunbtbl/modification/index.html
/storageunbtbl/session/*
!/storageunbtbl/session/index.html
/storageunbtbl/upload/*
!/storageunbtbl/upload/index.html

# Bundled fallback storage runtime data
/upload/system/storage/cache/*
!/upload/system/storage/cache/index.html
/upload/system/storage/download/*
!/upload/system/storage/download/index.html
/upload/system/storage/logs/*
!/upload/system/storage/logs/index.html
/upload/system/storage/modification/*
!/upload/system/storage/modification/index.html
/upload/system/storage/session/*
!/upload/system/storage/session/index.html
/upload/system/storage/upload/*
!/upload/system/storage/upload/index.html

# Temporary downloads and obsolete server-side backup copies
*.part
*.tmp
*.temp
*.bak
*.orig
*----
*---
*_backup

# Third-party test suites and fixture keys are not required in production
/storageunbtbl/vendor/**/Tests/
/storageunbtbl/vendor/**/tests/
/upload/system/storage/vendor/**/Tests/
/upload/system/storage/vendor/**/tests/
/upload/system/library/email_api/vendor/**/Tests/
/upload/system/library/email_api/vendor/**/tests/
