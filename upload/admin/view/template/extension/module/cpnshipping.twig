{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
		<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
		    <input type="hidden" value="1" name="module_cpnshipping_status">
		    <div class="form-group">
		      <label class="col-sm-2 control-label">{{ entry_client_number }}</label>
		      <div class="col-sm-10">
		        <input type="text" style="width:300px" name="module_cpnshipping_data[client_number]" value="{{ module_cpnshipping_data.client_number ? module_cpnshipping_data.client_number : '' }}">
		      </div>
		    </div>
		    <div class="form-group">
		      <label class="col-sm-2 control-label">  {{ entry_api_user }}</label>
              <div class="col-sm-10">
               <input type="text" style="width:300px" name="module_cpnshipping_data[api_user]" value="{{ module_cpnshipping_data.api_user ? module_cpnshipping_data.api_user : '' }}">
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">  {{ entry_api_key }}</label>
              <div class="col-sm-10">
                <input type="text" style="width:300px" name="module_cpnshipping_data[api_key]" value="{{ module_cpnshipping_data.api_key ? module_cpnshipping_data.api_key : '' }}">
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-5 control-label">  {{ text_info }}</label>
              <label class="col-sm-7 control-label">  </label>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">  {{ entry_sender_name }}</label>
              <div class="col-sm-10">
                <input type="text" style="width:300px" name="module_cpnshipping_data[sender_name]" value="{{ module_cpnshipping_data.sender_name ? module_cpnshipping_data.sender_name : '' }}">
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">  {{ entry_sender_address }}</label>
              <div class="col-sm-10">
                 <input type="text" style="width:300px" name="module_cpnshipping_data[sender_address]" value="{{ module_cpnshipping_data.sender_address ? module_cpnshipping_data.sender_address : '' }}">
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">  {{ entry_sender_zipcode }}</label>
              <div class="col-sm-10">
                  <input type="text" style="width:300px" name="module_cpnshipping_data[sender_zipcode]" value="{{ module_cpnshipping_data.sender_zipcode ? module_cpnshipping_data.sender_zipcode : '' }}">
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">  {{ entry_sender_city }}</label>
              <div class="col-sm-10">
                  <input type="text" style="width:300px" name="module_cpnshipping_data[sender_city]" value="{{ module_cpnshipping_data.sender_city ? module_cpnshipping_data.sender_city : '' }}">
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">  {{ entry_sender_country }}</label>
              <div class="col-sm-10">
                  <input type="text" style="width:300px" name="module_cpnshipping_data[sender_country]" value="{{ module_cpnshipping_data.sender_country ? module_cpnshipping_data.sender_country : '' }}">
              </div>
            </div> 
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
