{% if mpadditional_fields %}
{% if mpadditional_fields_current_theme == 'journal3' %}
<ul id="mpadditional_fields-container">
{% endif %}
{% for mpadditional_field in mpadditional_fields %}
  {% if mpadditional_field.image is empty %}
    <li class="mpadditional_field mpadditional_field_text"><b>{{ mpadditional_field.name }}:</b> <span>{{ mpadditional_field.value }}</span></li>
  {% endif %}
{% endfor %}
{% for mpadditional_field in mpadditional_fields %}
  {% if mpadditional_field.image|length %}
  <li class="mpadditional_field mpadditional_field_img clearfix">
    <span class="text">
      <h4>{{ mpadditional_field.name }}</h4>
      <p>{{ mpadditional_field.value }}</p>
    </span>
    <span class="image"><img class="img-responsive" src="{{ mpadditional_field.image }}" alt="{{ mpadditional_field.name }}" /></span>
  </li>
  {% endif %}
{% endfor %}
{% if mpadditional_fields_current_theme == 'journal3' %}
</ul>
{% endif %}
{% endif %}

{% if mpadditional_fields_current_theme == 'journal3' %}
<script type="text/javascript"><!--
$(function() {
  $('ul#mpadditional_fields-container > li').appendTo('.product-stats ul:first-child');
});
//--></script>
{% endif %}