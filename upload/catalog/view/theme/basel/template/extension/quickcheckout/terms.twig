<div id="payment" class="text-left" style="display:none;"></div>
<div class="terms">
  <div class="legal-guarantee-checkout">
    <a href="{{ legal_guarantee_url }}" data-toggle="modal" data-target="#legal-guarantee-modal" aria-controls="legal-guarantee-modal" aria-haspopup="dialog"><i class="fa fa-shield" aria-hidden="true"></i>{{ text_legal_guarantee }}</a>
  </div>
  <label>{% if text_agree %}
    {{ text_agree }}
    <input type="checkbox" name="agree" value="1" />
  {% endif %}</label>
  <button type="button" id="button-payment-method" class="btn btn-primary" data-loading-text="{{ text_loading }}">{{ button_continue }}</button>
</div>
